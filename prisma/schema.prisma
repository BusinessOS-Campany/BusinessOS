/// Pending platform approval to install an app into an existing (already active) organization.
/// Created when a tenant requests a SECOND+ system — unlike the first app,
/// additional systems require platform review.
model organizationAppRequest {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  appId             String       @map("app_id")
  requestedByUserId String       @map("requested_by_user_id")
  /// pending | approved | rejected
  status            String       @default("pending")
  planCode          String?
  note              String?
  decidedByUserId   String?      @map("decided_by_user_id")
  decidedAt         DateTime?    @map("decided_at")
  rejectReason      String?      @map("reject_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  app          app          @relation(fields: [appId], references: [id], onDelete: Cascade)
  organization organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  user         @relation("OrgAppRequestRequester", fields: [requestedByUserId], references: [id])

  @@unique([organizationId, appId])
  @@index([organizationId, status])
  @@index([status, createdAt])
  @@map("organization_app_requests")
}

/// User-pinned apps for quick access on home / workspace.
model pinnedApp {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  appId     String   @map("app_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user user @relation("UserPinnedSystems", fields: [userId], references: [id], onDelete: Cascade)
  app  app  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([appId])
  @@map("pinned_apps")
}

/// The password a member uses INSIDE one organization's own copy of a system.
///
/// Each org runs its own copy of a cloned system (`system/<slug>/` copied into
/// `orginazition/<org>/systems/<slug>/`), and each copy has its own database with
/// its own `users` table that the platform cannot read. The platform stores
/// Better Auth's scrypt hash in `accounts.password`, which no cloned system can
/// verify and which cannot be converted to bcrypt. So at the only two moments the
/// platform sees the plaintext — signup and change-password — it also writes a
/// bcrypt-12 hash here, and pushes it into the clone's `users.passwordHash`. That
/// is what lets a member sign in with one email and one password on both sides.
///
/// One row per (org, app, user): the same person in two orgs gets two rows, and
/// removing a member from an org cascades this away.
///
/// Absent row = no direct login for that pair, and the member reaches the system
/// through the platform's gateway instead. That is the correct state for a social
/// login (there is no password to mirror) and for anyone who has not re-confirmed
/// their password since this shipped. Never written with plaintext: `passwordHash`
/// is always a bcrypt digest, and the platform's own scrypt hash is never copied here.
model systemCredential {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  appId          String   @map("app_id")
  userId         String   @map("user_id")
  /// The username this person signs in with inside the clone. Stays the platform
  /// username, so the profile page can show the member what to type.
  username       String
  /// bcrypt-12 digest, produced by the same library and cost the clone verifies with.
  passwordHash   String   @map("password_hash")
  /// When this digest was last pushed into the clone's own database. Null means
  /// stored but not yet delivered.
  syncedAt       DateTime? @map("synced_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         user         @relation("UserSystemCredentials", fields: [userId], references: [id], onDelete: Cascade)
  organization organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app          app          @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([organizationId, appId, userId])
  @@index([userId])
  @@index([organizationId, appId])
  @@map("system_credentials")
}

/// Social follow graph between platform users.
model userFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  user @relation("UserFollowsFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following user @relation("UserFollowsFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}
