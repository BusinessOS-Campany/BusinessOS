generator client {
  provider = "prisma-client"
  output   = "../src/core/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                                            String                      @id
  name                                          String
  /// Nullable so a user can register with a phone number instead. Both
  /// identifiers are unique independently, and exactly one of them is required
  /// (enforced in the signup route, not by the database).
  email                                         String?                     @unique
  emailVerified                                 Boolean                     @default(false) @map("email_verified")
  image                                         String?
  createdAt                                     DateTime                    @default(now()) @map("created_at")
  updatedAt                                     DateTime                    @updatedAt @map("updated_at")
  banReason                                     String?                     @map("ban_reason")
  banned                                        Boolean                     @default(false)
  /// Better Auth admin-plugin realm: platform owner vs normal user.
  /// Tenant roles live in member.role — this is ONLY for the platform console.
  role                                          String                      @default("user")
  /// Public @handle shown on the profile. Optional, unique, and normalised to
  /// lower case by the API. NOT a login identifier: sign-in is email-or-phone
  /// only (see core/auth/identifier.ts). There is no public profile page, so
  /// this is a display handle, not an address.
  username                                      String?                     @unique
  /// Profile banner. Same-origin API path (like `image`) or an absolute https
  /// URL; the API validates which. Null falls back to a generated gradient.
  coverImage                                    String?                     @map("cover_image")
  bio                                           String?
  /// E.164-ish national number, stored WITHOUT the country dial code; the
  /// dial code lives in `countryCode` so the two can be changed independently.
  /// Unique so a phone number identifies exactly one account.
  phone                                         String?                     @unique
  /// ISO 3166-1 alpha-2 dial-code country the phone was entered against,
  /// e.g. "YE" for +967. Set only for phone registrations.
  countryCode                                   String?                     @map("country_code")
  locale                                        String                      @default("ar")
  preferences                                   Json?
  privacy                                       Json?
  profileExtras                                 Json?                                 @map("profile_extras")
  socials                                       Json?
  accounts                                      account[]
  members                                       member[]
  sessions                                      session[]
  following                                     userFollow[]                @relation("UserFollowsFollowing")
  followers                                     userFollow[]                @relation("UserFollowsFollower")
  orgAppRequests                                organizationAppRequest[]    @relation("OrgAppRequestRequester")
  pinned                                        pinnedApp[]                 @relation("UserPinnedSystems")
  systemCredentials                             systemCredential[]          @relation("UserSystemCredentials")

  @@map("users")
}

model session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")
  /// Set while a platform admin is impersonating this session's user.
  impersonatedBy       String?  @map("impersonated_by")
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  issuer                String?
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model organization {
  id                        String                      @id
  name                      String
  slug                      String                      @unique
  logo                      String?
  metadata                  String?
  createdAt                 DateTime                    @default(now()) @map("created_at")
  planId                    String?                     @map("plan_id")
  /// Platform-controlled lifecycle: active | suspended.
  status                    String                      @default("active")
  /// Tenant settings JSON: currency, tax, enabled modules, receipt config…
  settings                  Json?
  /// Industry template applied at provisioning (e.g. "grocery").
  templateCode              String?                     @map("template_code")
  schemaName                String?                     @map("schema_name")
  databaseName              String?                     @map("database_name")
  auditLogs                 auditLog[]
  invitations               invitation[]
  members                   member[]
  orgAppRequests            organizationAppRequest[]
  orgApps                   organizationApp[]
  systemCredentials         systemCredential[]
  plan                      plan?                       @relation(fields: [planId], references: [id])

  @@map("organizations")
}

model plan {
  id                String         @id @default(cuid())
  code              String         @unique
  nameAr            String         @map("name_ar")
  nameEn            String         @map("name_en")
  priceMonthlyMinor BigInt         @default(0) @map("price_monthly_minor")
  currency          String         @default("SAR")
  /// Plan caps: JSON like {"users":10,"branches":1,"aiCreditsPerMonth":0}
  limits            Json
  isActive          Boolean        @default(true) @map("is_active")
  sortOrder         Int            @default(0) @map("sort_order")
  createdAt         DateTime       @default(now()) @map("created_at")
  organizations     organization[]

  @@map("plans")
}

model announcement {
  id              String    @id @default(cuid())
  titleAr         String    @map("title_ar")
  titleEn         String    @map("title_en")
  bodyAr          String    @map("body_ar")
  bodyEn          String    @map("body_en")
  /// all = every tenant; org = only organizationId below
  audience        String    @default("all")
  organizationId  String?   @map("organization_id")
  severity        String    @default("info")
  publishedAt     DateTime? @map("published_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([audience, publishedAt])
  @@map("announcements")
}

model member {
  id             String       @id
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  email          String
  role           String
  status         String
  expiresAt      DateTime     @map("expires_at")
  inviterId      String       @map("inviter_id")
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

model auditLog {
  id             String        @id @default(cuid())
  /// Null for platform-realm events (impersonation, provisioning).
  organizationId String?       @map("organization_id")
  actorUserId    String?       @map("actor_user_id")
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Master registry of available applications on the platform.
model app {
  id                        String                      @id @default(cuid())
  slug                      String                      @unique
  name                      String
  nameAr                    String?                     @map("name_ar")
  description               String?
  descriptionAr             String?                     @map("description_ar")
  icon                      String?
  category                  String                      @default("business")
  /// Optional cover image URL for marketplace cards.
  image                     String?
  /// Database/schema identifier for the system's data (e.g. "grocery").
  /// Null = shares the tenant's default schema (organizationId-scoped rows).
  schemaKey                 String?                     @map("schema_key")
  version                   String                      @default("1.0.0")
  /// dormant | active | deprecated — platform-wide status
  status                    String                      @default("active")
  /// Route prefix inside the app shell (e.g. "/app/grocery")
  routePrefix               String                      @map("route_prefix")
  /// JSON: capability flags — { offlineSupported, syncSupported, barcodeSupported, printingSupported, cameraSupported }
  capabilities              Json                        @default("{}")
  /// JSON: Zod-compatible schema for app-specific configuration
  configurationSchema       Json?                       @map("configuration_schema")
  /// JSON: array of permission strings this app requires (e.g. ["grocery.products.view"])
  permissions               Json                        @default("[]")
  /// JSON: navigation items — [{name, href, icon, permission}]
  navigation                Json                        @default("[]")
  /// JSON: dashboard widget definitions this app provides
  dashboardWidgets          Json?                       @map("dashboard_widgets")
  /// JSON: AI tool definitions this app exposes
  aiTools                   Json?                       @map("ai_tools")
  isActive                  Boolean                     @default(true) @map("is_active")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  orgAppRequests            organizationAppRequest[]
  organizationApps          organizationApp[]
  systemCredentials         systemCredential[]
  pinnedBy                  pinnedApp[]

  @@map("apps")
}

/// Tracks which applications each organization has installed.
model organizationApp {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  appId          String       @map("app_id")
  /// installed | active | disabled | suspended
  status         String       @default("active")
  version        String       @default("1.0.0")
  /// App-specific configuration override (JSON)
  configuration  Json?
  /// App-specific settings (JSON) — receipts, currency overrides, etc.
  settings       Json?
  installedAt    DateTime     @default(now()) @map("installed_at")
  activatedAt    DateTime?    @map("activated_at")
  disabledAt     DateTime?    @map("disabled_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  app            app          @relation(fields: [appId], references: [id], onDelete: Cascade)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, appId])
  @@index([organizationId, status])
  @@index([appId])
  @@map("organization_apps")
}

model category {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  parentId       String?  @map("parent_id")
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model unit {
  /// Unit of measure. `factor` converts to the product's base unit:
  /// qty_in_base = qty_in_this_unit * factor (piece=1, box_of_12=12…).
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
  shortAr        String?  @map("short_ar")
  shortEn        String?  @map("short_en")
  factor         Decimal  @db.Decimal(18, 6)
  isBase         Boolean  @default(false) @map("is_base")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("units")
}

model product {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  categoryId     String?  @map("category_id")
  baseUnitId     String?  @map("base_unit_id")
  sku            String
  barcode        String?
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
  costPrice      BigInt   @default(0) @map("cost_price")
  salePrice      BigInt   @default(0) @map("sale_price")
  wholesalePrice BigInt?  @map("wholesale_price")
  taxRateBps     Int      @default(0) @map("tax_rate_bps")
  trackStock     Boolean  @default(true) @map("track_stock")
  /// Reorder threshold for low-stock detection (null = never flags).
  minStock       Decimal? @map("min_stock")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, nameAr])
  @@index([organizationId, isActive])
  @@index([categoryId])
  @@map("products")
}

model branch {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  nameAr         String   @map("name_ar")
  nameEn         String?
  phone          String?
  address        String?
  isMain         Boolean  @default(false) @map("is_main")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("branches")
}

model warehouse {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id")
  nameAr         String   @map("name_ar")
  nameEn         String?
  isMain         Boolean  @default(false) @map("is_main")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([branchId])
  @@map("warehouses")
}

model stockLevel {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  productId      String  @map("product_id")
  warehouseId    String  @map("warehouse_id")
  qty            Decimal @default(0) @db.Decimal(18, 3)

  @@unique([productId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("stock_levels")
}

model stockMovement {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  productId       String   @map("product_id")
  warehouseId     String   @map("warehouse_id")
  /// Signed quantity change; ledger sum must equal stock_levels.qty.
  qtyDelta        Decimal  @map("qty_delta") @db.Decimal(18, 3)
  /// sale | sale_return | purchase | adjustment | transfer_out | transfer_in
  reason          String
  refType         String?  @map("ref_type")
  refId           String?  @map("ref_id")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, productId, warehouseId, createdAt])
  @@index([organizationId, refType, refId])
  @@map("stock_movements")
}

model customer {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String?
  email          String?
  /// Max outstanding credit in minor units; 0 = cash-only.
  creditLimit    BigInt   @default(0) @map("credit_limit")
  /// Receivable balance: positive = customer owes us.
  balance        BigInt   @default(0)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@map("customers")
}

model supplier {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String?
  /// Payable balance: positive = we owe supplier.
  balance        BigInt   @default(0)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, name])
  @@map("suppliers")
}

model expenseCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  nameAr         String   @map("name_ar")
  nameEn         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("expense_categories")
}

model expense {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  categoryId      String?  @map("category_id")
  amount          BigInt
  cashAccountId   String?  @map("cash_account_id")
  note            String?
  spentAt         DateTime @map("spent_at")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, spentAt])
  @@index([categoryId])
  @@index([cashAccountId])
  @@map("expenses")
}

model cashAccount {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  nameAr         String   @map("name_ar")
  nameEn         String?
  /// cash | bank
  type           String   @default("cash")
  openingBalance BigInt   @default(0) @map("opening_balance")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("cash_accounts")
}

model cashMovement {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  accountId       String   @map("account_id")
  /// Signed minor-unit delta; sum + opening == account balance.
  delta           BigInt
  /// sale_payment | purchase_payment | expense | refund | adjustment | deposit | withdrawal
  reason          String
  refType         String?  @map("ref_type")
  refId           String?  @map("ref_id")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, refType, refId])
  @@map("cash_movements")
}

/// Gap-tolerant document numbering, allocated inside the caller's tx.
model numberSequence {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  /// sales_invoice | sales_return | purchase | expense
  key            String
  prefix         String?
  nextValue      Int     @default(1) @map("next_value")
  padding        Int     @default(5) @map("padding")

  @@unique([organizationId, key])
  @@map("number_sequences")
}

model salesInvoice {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  number          String
  customerId      String?  @map("customer_id")
  warehouseId     String?  @map("warehouse_id")
  /// posted | voided
  status          String   @default("posted")
  issuedAt        DateTime @default(now()) @map("issued_at")
  subtotal        BigInt
  discountTotal   BigInt   @default(0) @map("discount_total")
  taxTotal        BigInt   @map("tax_total")
  total           BigInt
  paidTotal       BigInt   @default(0) @map("paid_total")
  notes           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([organizationId, number])
  @@index([organizationId, issuedAt])
  @@index([organizationId, customerId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, status, issuedAt])
  @@map("sales_invoices")
}

model salesInvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String  @map("invoice_id")
  organizationId String  @map("organization_id")
  productId      String  @map("product_id")
  qty            Decimal @db.Decimal(18, 3)
  unitPrice      BigInt  @map("unit_price")
  discount       BigInt  @default(0)
  taxRateBps     Int     @map("tax_rate_bps")
  lineSubtotal   BigInt  @map("line_subtotal")
  lineTax        BigInt  @map("line_tax")
  lineTotal      BigInt  @map("line_total")
  /// Cost snapshot at sale time → gross profit reporting without revaluation.
  unitCost       BigInt  @default(0) @map("unit_cost")

  @@index([invoiceId])
  @@index([organizationId, productId])
  @@map("sales_invoice_items")
}

model payment {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  invoiceId       String   @map("invoice_id")
  /// cash | card | transfer | credit
  method          String
  amount          BigInt
  cashAccountId   String?  @map("cash_account_id")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([organizationId, createdAt])
  @@index([cashAccountId])
  @@map("payments")
}

model purchase {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  number          String
  supplierId      String?   @map("supplier_id")
  warehouseId     String?   @map("warehouse_id")
  /// received (stock applied atomically at creation in M4; drafts land later)
  status          String    @default("received")
  issuedAt        DateTime  @default(now()) @map("issued_at")
  receivedAt      DateTime? @map("received_at")
  subtotal        BigInt
  taxTotal        BigInt    @map("tax_total")
  total           BigInt
  paidTotal       BigInt    @default(0) @map("paid_total")
  notes           String?
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, number])
  @@index([organizationId, issuedAt])
  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("purchases")
}

model purchaseItem {
  id             String  @id @default(cuid())
  purchaseId     String  @map("purchase_id")
  organizationId String  @map("organization_id")
  productId      String  @map("product_id")
  qty            Decimal @db.Decimal(18, 3)
  unitCost       BigInt  @map("unit_cost")
  taxRateBps     Int     @map("tax_rate_bps")
  lineTotal      BigInt  @map("line_total")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model salesReturn {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  invoiceId       String   @map("invoice_id")
  number          String
  total           BigInt
  refunded        BigInt   @default(0)
  reason          String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([organizationId, number])
  @@index([organizationId, invoiceId])
  @@map("sales_returns")
}

model salesReturnItem {
  id             String  @id @default(cuid())
  returnId       String  @map("return_id")
  organizationId String  @map("organization_id")
  productId      String  @map("product_id")
  qty            Decimal @db.Decimal(18, 3)
  unitPrice      BigInt  @map("unit_price")
  lineTotal      BigInt  @map("line_total")

  @@index([returnId])
  @@index([productId])
  @@map("sales_return_items")
}

model brand {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  nameAr         String?  @map("name_ar")
  description    String?
  logoUrl        String?  @map("logo_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("brands")
}

model productBarcode {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  barcode        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, barcode])
  @@index([productId])
  @@map("product_barcodes")
}

model productBatch {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  batchNo        String    @map("batch_no")
  mfgDate        DateTime? @map("mfg_date")
  expiryDate     DateTime? @map("expiry_date")
  quantity       Decimal   @db.Decimal(18, 3)
  costPrice      BigInt    @default(0) @map("cost_price")
  supplierId     String?   @map("supplier_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, productId, batchNo])
  @@index([expiryDate])
  @@index([productId, expiryDate])
  @@map("product_batches")
}

model customerGroup {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  nameAr         String?  @map("name_ar")
  description    String?
  discountRate   Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)
  priceMode      String   @default("retail") @map("price_mode")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("customer_groups")
}

model customerTransaction {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  customerId      String   @map("customer_id")
  /// debt | payment | refund | adjustment
  type            String
