  balanceAfter    BigInt   @map("balance_after")
  refType         String?  @map("ref_type")
  refId           String?  @map("ref_id")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, customerId, createdAt])
  @@index([type])
  @@map("customer_transactions")
}

model loyaltyTransaction {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  /// earn | redeem | adjust
  type           String
  points         Decimal  @db.Decimal(18, 2)
  balanceAfter   Decimal  @map("balance_after") @db.Decimal(18, 2)
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, customerId, createdAt])
  @@map("loyalty_transactions")
}

model purchaseOrder {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  poNumber        String    @map("po_number")
  supplierId      String    @map("supplier_id")
  createdByUserId String?   @map("created_by_user_id")
  orderDate       DateTime  @default(now()) @map("order_date")
  expectedDate    DateTime? @map("expected_date")
  /// draft | pending | approved | ordered | partially_received | received | cancelled
  status          String    @default("draft")
  subtotal        BigInt
  discountTotal   BigInt    @default(0) @map("discount_total")
  total           BigInt
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, poNumber])
  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
  @@map("purchase_orders")
}

model purchaseOrderItem {
  id              String  @id @default(cuid())
  organizationId  String  @map("organization_id")
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  quantity        Decimal @db.Decimal(18, 3)
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(18, 3)
  unitCost        BigInt  @map("unit_cost")
  discount        BigInt  @default(0)
  taxRateBps      Int     @default(0) @map("tax_rate_bps")
  lineTotal       BigInt  @map("line_total")

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model purchaseReturn {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  returnNumber    String   @map("return_number")
  supplierId      String   @map("supplier_id")
  purchaseId      String?  @map("purchase_id")
  createdByUserId String?  @map("created_by_user_id")
  date            DateTime @default(now())
  subtotal        BigInt
  total           BigInt
  reason          String
  refundAmount    BigInt   @default(0) @map("refund_amount")
  creditAmount    BigInt   @default(0) @map("credit_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, returnNumber])
  @@index([organizationId, supplierId])
  @@index([organizationId, date])
  @@map("purchase_returns")
}

model purchaseReturnItem {
  id               String  @id @default(cuid())
  organizationId   String  @map("organization_id")
  purchaseReturnId String  @map("purchase_return_id")
  productId        String  @map("product_id")
  quantity         Decimal @db.Decimal(18, 3)
  unitCost         BigInt  @map("unit_cost")
  lineTotal        BigInt  @map("line_total")

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

model stockAdjustment {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  adjustmentNumber String   @map("adjustment_number")
  productId        String   @map("product_id")
  /// increase | decrease
  type             String
  quantity         Decimal  @db.Decimal(18, 3)
  previousQuantity Decimal  @map("previous_quantity") @db.Decimal(18, 3)
  newQuantity      Decimal  @map("new_quantity") @db.Decimal(18, 3)
  reason           String
  note             String?
  createdByUserId  String?  @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
  @@map("stock_adjustments")
}

/// Tenant-defined fields attached to any business entity. Values live in
/// custom_field_values (EAV-lite) so unique/index flags are enforceable and
/// report datasets can aggregate them without schema migrations.
model customField {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Target entity: products | customers | suppliers | sales | purchases
  entityType     String   @map("entity_type")
  /// Machine key used in formulas/rules; unique per org+entityType.
  key            String
  nameAr         String   @map("name_ar")
  nameEn         String?  @map("name_en")
  /// One of CUSTOM_FIELD_TYPES (21 types, see src/core/custom-fields/types.ts)
  type           String
  /// Select/multiselect choices etc.: {choices:[{value,labelAr,labelEn}]}
  options        Json?
  /// Conditional visibility/validation: {required,min,max,regex,visibleWhen}
  rules          Json?
  isUnique       Boolean  @default(false) @map("is_unique")
  hasIndex       Boolean  @default(false) @map("has_index")
  isEncrypted    Boolean  @default(false) @map("is_encrypted")
  /// Formula expression for computed fields (safe parser only).
  formula        String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, isActive])
  @@map("custom_fields")
}

model customFieldValue {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  fieldId        String    @map("field_id")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  valueText      String?   @map("value_text")
  /// Encrypted payloads (AES-256-GCM) stored here with "enc:v1:" prefix.
  valueNumber    Float?    @map("value_number")
  valueDate      DateTime? @map("value_date")
  valueBool      Boolean?  @map("value_bool")

  @@unique([fieldId, entityId])
  @@index([organizationId, entityType, entityId])
  @@index([fieldId, valueText])
  @@index([fieldId, valueNumber])
  @@map("custom_field_values")
}

/// Saved table views per user/module: columns, filters, sort.
model savedView {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Null = shared view visible to the whole org.
  userId         String?  @map("user_id")
  entityType     String   @map("entity_type")
  name           String
  /// {columns:[key|builtin], filters:[{key,op,value}], sort:{key,dir}}
  config         Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, entityType])
  @@index([userId])
  @@map("saved_views")
}

/// Per-user dashboard widget layouts.
model dashboardLayout {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")
  /// {widgets:[{i,type,moduleId,title,x,y,w,h}]}
  layout         Json

  @@unique([organizationId, userId])
  @@map("dashboard_layouts")
}

/// Transactional outbox events. Written in the SAME tx as the business write.
/// A pg-backed worker polls and dispatches matching workflow rules.
model outboxEvent {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  /// Domain event key, e.g. "sale.created", "inventory.low", "debt.limit"
  eventType      String    @map("event_type")
  /// Idempotency key: deduplicates identical events across tx retries.
  /// Unique per org+eventType+entityId — same event never processed twice.
  dedupeKey      String    @map("dedupe_key")
  /// Entity that triggered the event (e.g. sale invoice id).
  entityId       String?   @map("entity_id")
  /// Full event payload (JSON-serializable).
  payload        Json
  /// Pending | Processing | Completed | Failed | DeadLettered
  status         String    @default("pending")
  /// Exponential backoff: attempt 0 → 1m, 1 → 2m, 2 → 4m …
  attempt        Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  lastError      String?   @map("last_error")
  nextRunAt      DateTime? @map("next_run_at")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, dedupeKey])
  @@index([status, nextRunAt])
  @@index([organizationId, eventType])
  @@map("outbox_events")
}

/// Code-registered trigger → condition → action rules per tenant.
model workflowRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  /// Domain event type this rule listens to (e.g. "sale.created", "inventory.low")
  triggerEvent   String   @map("trigger_event")
  /// Safe JSON condition AST: {field, op, value} or {logic:"and|or", children:[...]}
  conditions     Json
  /// Array of actions: [{type:"notification|webhook|create_record|email_log|task", config:{...}}]
  actions        Json
  isActive       Boolean  @default(true) @map("is_active")
  /// If true, workflow was generated by AI and must be explicitly activated.
  isDraft        Boolean  @default(false) @map("is_draft")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, triggerEvent, isActive])
  @@map("workflow_rules")
}

/// Execution log for every workflow rule fire.
model workflowExecution {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  ruleId         String   @map("rule_id")
  /// The outbox event that triggered this execution.
  eventId        String?  @map("event_id")
  /// Success | Failed | DeadLettered
  status         String
  /// Action type that was executed.
  actionType     String   @map("action_type")
  /// Serialized result/error from the action executor.
  result         Json?
  /// Duration in milliseconds.
  durationMs     Int?     @map("duration_ms")
  attempt        Int      @default(1)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, status])
  @@map("workflow_executions")
}

/// Webhook endpoints registered by tenant admins.
model webhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Human-readable name (e.g. "Slack notifications")
  name           String
  /// Target URL
  url            String
  /// HMAC-SHA256 signing key (hex). Null = no signing.
  signingKey     String?  @map("Signing_key")
  /// Event types to deliver (JSON array of strings). Empty = all events.
  events         Json     @default("[]")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, isActive])
  @@map("webhook_endpoints")
}

/// In-app notifications for users.
model notification {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Target user (null = broadcast to all org members).
  userId         String?  @map("user_id")
  /// Notification title
  titleAr        String?  @map("title_ar")
  titleEn        String?  @map("title_en")
  /// Notification body
  bodyAr         String?  @map("body_ar")
  bodyEn         String?  @map("body_en")
  /// Link to navigate to when clicked.
  href           String?
  /// Read status
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, userId, isRead])
  @@map("notifications")
}

/// Registered devices per user. Updated on each sync.
model syncDevice {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  /// Client-generated device fingerprint (stable across sessions).
  fingerprint    String
  /// Browser/platform info (e.g. "Chrome 120 / Windows 10").
  platform       String?
  /// ISO timestamp of last successful sync.
  lastSyncAt     DateTime? @map("last_sync_at")
  /// Number of pending outbox ops on this device.
  pendingCount   Int       @default(0) @map("pending_count")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, userId, fingerprint])
  @@index([organizationId, userId])
  @@map("sync_devices")
}

/// Idempotency keys for sync replay protection. Expires after 7 days.
model idempotencyKey {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Unique sync operation key (client UUID + entity + op type).
  key            String
  /// HTTP status code of the original response.
  statusCode     Int      @map("status_code")
  /// Serialized response body (the original result).
  result         Json
  createdAt      DateTime @default(now()) @map("created_at")
  /// Auto-cleanup after 7 days.
  expiresAt      DateTime @map("expires_at")

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Conflicting concurrent edits surfaced to admin for resolution.
model conflictQueue {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  /// Entity type that conflicted (e.g. "product", "customer").
  entityType       String    @map("entity_type")
  /// Entity ID that conflicted.
  entityId         String    @map("entity_id")
  /// Field name that differs.
  fieldName        String    @map("field_name")
  /// The client-submitted value.
  localValue       Json      @map("local_value")
  /// The current server value.
  remoteValue      Json      @map("remote_value")
  /// Timestamps for audit.
  localUpdatedAt   DateTime? @map("local_updated_at")
  remoteUpdatedAt  DateTime? @map("remote_updated_at")
  /// pending | resolved_local | resolved_remote
  status           String    @default("pending")
  /// The winning value after resolution.
  resolvedValue    Json?     @map("resolved_value")
  /// User who resolved (null = pending).
  resolvedByUserId String?   @map("resolved_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  resolvedAt       DateTime? @map("resolved_at")

  @@index([organizationId, entityType, status])
  @@index([organizationId, entityId])
  @@map("conflict_queue")
}

/// Held / suspended POS carts. JSON payload preserves the exact cart state so
/// resumed carts produce identical sales. One hold per session at a time.
model posHold {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  branchId        String?  @map("branch_id")
  warehouseId     String   @map("warehouse_id")
  customerId      String?  @map("customer_id")
  cashAccountId   String?  @map("cash_account_id")
  /// Serialized cart: { items: [{ productId, qty, unitPrice, discount }], notes, discountTotal }
  cart            Json
  /// Human-readable label shown in the hold list (e.g. "Table 3" or cashier name)
  label           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([createdByUserId])
  @@map("pos_holds")
}

/// LLM provider configuration. Platform admins configure endpoint/model/key.
model aiProvider {
  id        String   @id @default(cuid())
  name      String
  /// Base URL of the OpenAI-compatible endpoint
  endpoint  String
  /// Model identifier (e.g. "gpt-4o", "claude-3-sonnet")
  model     String
  /// Encrypted API key
  apiKey    String   @map("api_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_providers")
}

/// Per-org AI usage logs for metering + billing.
model aiUsageLog {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  providerId      String?  @map("provider_id")
  model           String
  /// Input/prompt tokens
  tokensIn        Int      @default(0) @map("tokens_in")
  /// Output/completion tokens
  tokensOut       Int      @default(0) @map("tokens_out")
  /// Cost in minor currency units (bigint stored as Int for Prisma compat)
  costMicro       Int      @default(0) @map("cost_micro")
  /// Tool calls made during this request
  toolCalls       Int      @default(0) @map("tool_calls")
  /// Conversation grouping
  conversationId  String?  @map("conversation_id")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("ai_usage_logs")
}

/// Single-use confirmation tokens for mutating AI actions.
model aiConfirmToken {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  /// The pending action type (e.g. "create_customer", "create_sale_draft")
  actionType      String   @map("action_type")
  /// Serialized action args (JSON)
  actionArgs      Json     @map("action_args")
  /// Tool call ID that produced this pending action
  toolCallId      String   @map("tool_call_id")
  createdByUserId String   @map("created_by_user_id")
  /// Single-use — set to true after execution
  used            Boolean  @default(false) @map("used")
  /// Expiry (15 minutes)
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdByUserId])
  @@map("ai_confirm_tokens")
}

/// Scoped API keys for third-party integrations. Each key is bound to one org
/// and carries a JSON array of permission scopes (module:action pairs).
model apiKey {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  name            String
  /// Prefix shown in UI (first 8 chars of the hash). Not the secret itself.
  prefix          String
  /// SHA-256 hash of the full key. The raw key is only shown once at creation.
  keyHash         String    @map("key_hash")
  /// JSON array of scope strings like ["products:read", "sales:create"]
  scopes          Json      @default("[]")
  /// null = never expires
  expiresAt       DateTime? @map("expires_at")
  lastUsedAt      DateTime? @map("last_used_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, keyHash])
  @@index([organizationId, isActive])
  @@map("api_keys")
}

/// Rate-limit counter per API key. Sliding-window in PostgreSQL: rows older
/// than the window are pruned; current count lives here.
model apiRateLimit {
  id           String   @id @default(cuid())
  apiKeyId     String   @map("api_key_id")
  windowStart  DateTime @map("window_start")
  requestCount Int      @default(1) @map("request_count")

  @@unique([apiKeyId, windowStart])
  @@index([apiKeyId])
  @@map("api_rate_limits")
}

/// Delivery log for outbound webhooks.
model webhookDelivery {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  endpointId     String    @map("endpoint_id")
  eventType      String    @map("event_type")
  payload        Json
  /// HMAC signature sent in X-Webhook-Signature header.
  signature      String?
  /// HTTP status code from the target (null = not yet attempted / timeout).
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body")
  /// pending | success | failed | retrying
  status         String    @default("pending")
  attempt        Int       @default(1)
  maxAttempts    Int       @default(3) @map("max_attempts")
  lastError      String?   @map("last_error")
  nextRetryAt    DateTime? @map("next_retry_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

/// Data import jobs — CSV/XLSX upload → validate → preview → commit.
model importJob {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  /// products | customers | suppliers | opening_stock
  entityType      String    @map("entity_type")
  /// pending | validating | preview | committed | failed
  status          String    @default("pending")
  /// Original filename
  filename        String
  /// Total rows in file
  totalRows       Int       @default(0) @map("total_rows")
  /// Rows that passed validation
  validRows       Int       @default(0) @map("valid_rows")
  /// Rows that failed validation
  invalidRows     Int       @default(0) @map("invalid_rows")
  /// JSON: [{row,field,message}] validation errors
  errors          Json?
  /// Number of rows actually committed
  committedRows   Int       @default(0) @map("committed_rows")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([organizationId, entityType])
  @@map("import_jobs")
}

/// Data export jobs — async generation with status tracking.
model dataExport {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  /// products | customers | suppliers | sales | purchases | inventory | expenses
  entityType      String    @map("entity_type")
  /// csv | xlsx
  format          String    @default("csv")
  /// pending | processing | completed | failed
  status          String    @default("pending")
  /// Filter params used for the export (JSON)
  filters         Json?
  /// Total rows exported
  rowCount        Int       @default(0)
  /// File path or URL of the generated file
  fileUrl         String?   @map("file_url")
  fileSize        Int?      @map("file_size")
  sha256          String?
  errorMessage    String?   @map("error_message")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([organizationId, entityType])
  @@map("data_exports")
}

/// Backup records — pg_dump manifest with verification.
model backupRecord {
  id              String    @id @default(cuid())
  organizationId  String?   @map("organization_id")
  /// full | tenant
  type            String    @default("full")
  /// pending | completed | failed | verified
  status          String    @default("pending")
  /// File path of the dump
  filePath        String?   @map("file_path")
  fileSize        BigInt?   @map("file_size")
  /// SHA-256 of the dump file for integrity verification
  sha256          String?
  /// Whether the backup was verified (restored + checked)
  verified        Boolean   @default(false)
  errorMessage    String?   @map("error_message")
  /// JSON manifest: { tables: [...], rowCount: N, durationMs: N }
  manifest        Json?
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([organizationId, createdAt])
  @@map("backup_records")
}

/// Patient records for the physical therapy center
model samaPatient {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  serialNumber      Int       @map("serial_number")
  firstName         String    @map("first_name")
  lastName          String?   @map("last_name")
  phone             String?
  gender            String?
  dateOfBirth       DateTime? @map("date_of_birth")
  examType          String?   @map("exam_type")
  price             BigInt    @default(0)
  paymentMethod     String?   @map("payment_method")
  walletType        String?   @map("wallet_type")
  transactionNumber String?   @map("transaction_number")
  registrationDate  DateTime? @map("registration_date")
  notes             String?
  special           String?
  status            String    @default("progress")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([organizationId, serialNumber])
  @@index([organizationId, isActive])
  @@index([organizationId, phone])
  @@map("sama_patients")
}

