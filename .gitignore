# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev data
/.data/

# per-org system clones (customer-owned copies of system/<slug>)
/orginazition/
/.system-runtime/
# GitHub-imported system sources (checked out by the deployment worker; a
# customer's repository is never committed to this repo).
/.systems/

.vercel
.env*

# Nested copies (system/<slug>, demo-systems/<slug>) are full app trees.
# The anchored patterns above only match the repo root, so these must be
# unanchored or git tracks ~4GB of node_modules + .next caches.
node_modules/
.next/
.next-dev/
*.tsbuildinfo
.env
.env.*
!.env.example

# Local database dumps and schema exports. `backups/public-data-*.sql` is a
# pg_dump of live rows and carries real Google OAuth refresh tokens (`ya29.*`)
# and Better Auth session tokens, so it must never enter git.
backups/
databases/*.sql

# Runtime process logs
*.log
prod.err.log
prod.out.log

# Uploaded files written by the dental runtime. `src/lib/storage.ts` resolves its
# root from `process.cwd()`, which is the tree the app runs in, so this lands
# inside the source checkout for the master and demo trees. Both already hold an
# empty serverdata/uploads/imaging, and `/demo/dental` is publicly reachable, so a
# patient's file would otherwise sit one `git add -A` away from being committed.
# Per-org clones under orginazition/ are covered by that rule instead. Nothing
# tracked lives under any serverdata.
**/serverdata/

# Vendor git history for the sub-app trees that arrived as clones of
# github.com/gmsnow/dental-Clinic-. Renamed from .git so the platform repo can
# own our fork changes (basePath, SYSTEM_BASE_PATH, schema wiring); the upstream
# commits are still on GitHub. Restore the name to get the clone back.
**/.git.vendor-backup/

# Immutable production releases. `next build` writes `.next-staging`, the deploy
# pipeline verifies it and promotes it to `releases/<BUILD_ID>/`, and
# `npm run serve` starts whatever `.data/releases.json` names active. Keeping
# these out of git: they are build output, and each release is ~1.7 GB.
releases/
.next-staging/
.next-phone/
.data/
