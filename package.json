{
  "name": "businessos-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:erp": "next dev --webpack -p 3300",
    "dev:pos": "npm --prefix \"public/POS System\" run dev -- --port 3108",
    "dev:grocery": "npm --prefix demo-systems/grocery run dev -- --port 3101",
    "dev:sama": "concurrently -n sama-api,sama-web -c cyan,magenta \"npm --prefix public/samaSYSTEM-main/backend run dev\" \"npm --prefix public/samaSYSTEM-main/frontend run dev\"",
    "dev:celia": "npm --prefix public/celia-main run dev -- --port 3104",
    "dev:dental": "npm --prefix demo-systems/dental run dev -- --port 3106",
    "dev:pharmacy": "npm --prefix public/pharmacy run dev",
    "dev:optometry": "npm --prefix \"public/Optometry  Eye Clinic System\" run dev -- --port 3109",
    "build": "tsx scripts/build.ts",
    "start": "next start",
    "serve": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "powershell -NoProfile -Command \"$d=Join-Path (Get-Location) '.data/pg'; if (-not (Test-Path (Join-Path $d 'PG_VERSION'))) { $p=(Get-ItemProperty 'HKLM:/SOFTWARE/PostgreSQL/Installations/postgresql-x64-16' -Name 'Base Directory').\"Base Directory\"; & (Join-Path $p 'bin/initdb.exe') -D $d -U postgres --pwfile=<(echo bos_dev_2026) -E UTF8 }; $p=(Get-ItemProperty 'HKLM:/SOFTWARE/PostgreSQL/Installations/postgresql-x64-16' -Name 'Base Directory').\"Base Directory\"; & (Join-Path $p 'bin/pg_ctl.exe') -D $d -l .data/pg.log start\"",
    "db:stop": "powershell -NoProfile -Command \"$p=(Get-ItemProperty 'HKLM:/SOFTWARE/PostgreSQL/Installations/postgresql-x64-16' -Name 'Base Directory').\"Base Directory\"; & (Join-Path $p 'bin/pg_ctl.exe') -D (Join-Path (Get-Location) '.data/pg') stop\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@serwist/next": "^9.5.12",
    "@serwist/sw": "^9.5.12",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-table": "^9.1.2",
    "@types/three": "^0.185.4",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.9.1",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
