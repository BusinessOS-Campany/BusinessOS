# ── Database ────────────────────────────────────────────────────────────────
# Local dev cluster (see scripts "db:up") or any PostgreSQL 16+ URL.
# Docker alternative: postgres://bos:bos_dev_2026@localhost:5432/businessos
DATABASE_URL=postgresql://postgres:bos_dev_2026@localhost:5433/businessos
DIRECT_URL=postgresql://postgres:bos_dev_2026@localhost:5433/businessos

# ── Demo data (one demo_<slug> schema per entry in src/core/demo/demo-systems.ts)
# Demo schemas live in their OWN database, separate from the platform database,
# so a demo reset can never touch platform data. Unset → DATABASE_URL with the
# database segment swapped for `demo`. Used by scripts/provision-demo-schemas.ts.
# DEMO_DATABASE_URL=postgresql://postgres:bos_dev_2026@localhost:5433/demo

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Better Auth's baseURL — the OAuth `redirect_uri` is derived from it, so it must
# match the origin you actually browse. Keep it equal to NEXT_PUBLIC_APP_URL.
AUTH_URL=http://localhost:3100
# Social sign-in is shown in the UI only when the id+secret pair is present.
# In Google Cloud Console → the OAuth client's "Authorized redirect URIs" you MUST
# add, one entry per origin you serve (Google rejects anything else with
# `Error 400: redirect_uri_mismatch`):
#   http://localhost:3100/api/auth/callback/google
#   https://<your-prod-host>/api/auth/callback/google
# While the consent screen status is "Testing", add every signing-in Gmail under
# "Test users", or Google answers `Access blocked: This app's request is invalid`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100
LOG_LEVEL=debug

# ── Encryption ──────────────────────────────────────────────────────────────
# Required — used for encrypted custom-field values (AES-256-GCM). Without it
# the platform refuses to encrypt. NEVER reuse this key across deployments.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=

# ── Grocery app (standalone Next app in apps/grocery, port 3101) ──
# Tenant-authenticated and served same-origin at /app/grocery.
GROCERY_URL=http://localhost:3101

# Set to 1 to let `admin` / `admin` sign in to a cloned system's own login page
# at /app/<system>/login. An org is normally signed in by the platform through
# /api/bos/link, which leaves no account a password can open, so without this
# the cloned system's login form has nobody to accept. Off by default: the flag
# is what enables it, and clearing it closes the door (the account it creates
# gets an unusable password hash). The supervisor forwards this file's values to
# every runtime it starts, so no per-clone setup is needed. Never set this on a
# deployment real customers can reach.
# GROCERY_DEV_LOGIN=1

# ── Demo: SAMA Center (Vite SPA + Express API in public/samaSYSTEM-main) ──
# Served same-origin at /sama (frontend :3102, backend API :3103).
SAMA_WEB_URL=http://localhost:3102
SAMA_API_URL=http://localhost:3103

# ── Demo: Celia internet-café system (Next app in public/celia-main) ──
# Served same-origin at /celia (basePath /celia, port 3104).
CELIA_URL=http://localhost:3104

# ── Demo: POS System (Next app in public/POS System) ──
# Served same-origin at /pos (basePath /pos, port 3108).
POS_URL=http://localhost:3108

# Demo: Optometry eye clinic system (Next app in public/Optometry  Eye Clinic System)
# Served same-origin at /optometry (basePath /optometry, port 3109).
OPTOM_URL=http://localhost:3109

# ── Seed ────────────────────────────────────────────────────────────────────
SEED_PLATFORM_ADMIN_EMAIL=admin@businessos.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!2026

# ── AI (configured per-platform at runtime later; key stays here) ───────────
AI_API_KEY=

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PATH=./.data/storage
