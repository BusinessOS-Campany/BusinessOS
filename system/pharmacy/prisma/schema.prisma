// Pharmacy Management System — Prisma schema
// Designed for Yemen pharmacy operations: multi-branch, batch tracking, FEFO/FIFO, prescriptions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & Auth ──────────────────────────────────────────────────────────

model user {
  id             String    @id @default(cuid())
  username       String    @unique
  name           String
  nameAr         String?   @map("name_ar")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  phone          String?
  /// OWNER | ADMIN | PHARMACIST | CASHIER | INVENTORY_MANAGER | ACCOUNTANT
  role           String    @default("CASHIER")
  branchId       String?   @map("branch_id")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([role])
  @@map("users")
}

model passwordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Audit (append-only) ─────────────────────────────────────────────────────

model auditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ── Notification ─────────────────────────────────────────────────────────────

model notification {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  titleAr   String    @map("title_ar")
  titleEn   String    @map("title_en")
  bodyAr    String?   @map("body_ar")
  bodyEn    String?   @map("body_en")
  href      String?
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// ── Settings (single-row key/value store) ────────────────────────────────────

model setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ── Branches & Warehouses ───────────────────────────────────────────────────

model branch {
  id        String   @id @default(cuid())
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  phone     String?
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isActive])
  @@map("branches")
}

model warehouse {
  id        String   @id @default(cuid())
  branchId  String?  @map("branch_id")
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([branchId])
  @@map("warehouses")
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model category {
  id        String   @id @default(cuid())
  parentId  String?  @map("parent_id")
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([parentId])
  @@map("categories")
}

model manufacturer {
  id        String   @id @default(cuid())
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  country   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("manufacturers")
}

// ── Medicine ─────────────────────────────────────────────────────────────────

model medicine {
  id                    String   @id @default(cuid())
  categoryId            String?  @map("category_id")
  manufacturerId        String?  @map("manufacturer_id")
  sku                   String?
  barcode               String?
  nameAr                String   @map("name_ar")
  nameEn                String?  @map("name_en")
  genericName           String?  @map("generic_name")
  brandName             String?  @map("brand_name")
  activeIngredient      String?  @map("active_ingredient")
  strength              String?
  /// tablet | capsule | syrup | injection | cream | ointment | drops | spray | suppository | powder | solution | inhaler | other
  dosageForm            String?  @map("dosage_form")
  /// rx | otc | controlled
  medicineType          String   @default("otc") @map("medicine_type")
  countryOfOrigin       String?  @map("country_of_origin")
  description           String?
  imageUrl              String?  @map("image_url")
  // Inventory
  unit                  String   @default("piece")
  minStock              Decimal? @map("min_stock") @db.Decimal(18, 3)
  maxStock              Decimal? @map("max_stock") @db.Decimal(18, 3)
  reorderLevel          Decimal? @map("reorder_level") @db.Decimal(18, 3)
  // Pricing — BigInt minor units (1 YER = 100 minor)
  purchasePrice         BigInt   @default(0) @map("purchase_price")
  salePrice             BigInt   @default(0) @map("sale_price")
  wholesalePrice        BigInt?  @map("wholesale_price")
  minSalePrice          BigInt?  @map("min_sale_price")
  // Safety
  requiresPrescription  Boolean  @default(false) @map("requires_prescription")
  controlled            Boolean  @default(false)
  temperatureSensitive  Boolean  @default(false) @map("temperature_sensitive")
  storageInstructions   String?  @map("storage_instructions")
  warnings              String?
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([sku])
  @@unique([barcode])
  @@index([nameAr])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([isActive])
  @@index([medicineType])
  @@index([dosageForm])
  @@map("medicines")
}

model medicineBatch {
  id            String   @id @default(cuid())
  medicineId    String   @map("medicine_id")
  supplierId    String?  @map("supplier_id")
  purchaseId    String?  @map("purchase_id")
  batchNo       String   @map("batch_no")
  mfgDate       DateTime? @map("mfg_date")
  expiryDate    DateTime @map("expiry_date")
  initialQty    Decimal  @db.Decimal(18, 3) @map("initial_qty")
  remainingQty  Decimal  @db.Decimal(18, 3) @map("remaining_qty")
  purchasePrice BigInt   @default(0) @map("purchase_price")
  /// active | expired | returned | disposed
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([medicineId, batchNo])
  @@index([medicineId, expiryDate])
  @@index([expiryDate])
  @@index([status])
  @@index([supplierId])
  @@map("medicine_batches")
}

// ── Inventory (stock levels + movements) ─────────────────────────────────────

model stockLevel {
  id            String  @id @default(cuid())
  medicineId    String  @map("medicine_id")
  warehouseId   String  @map("warehouse_id")
  qty           Decimal @default(0) @db.Decimal(18, 3)

  @@unique([medicineId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model inventoryMovement {
  id            String   @id @default(cuid())
  medicineId    String   @map("medicine_id")
  warehouseId   String   @map("warehouse_id")
  batchId       String?  @map("batch_id")
  /// purchase | sale | sale_return | purchase_return | adjustment | transfer_out | transfer_in | damage | expiry
  type          String
  qtyDelta      Decimal  @db.Decimal(18, 3) @map("qty_delta")
  refType       String?  @map("ref_type")
  refId         String?  @map("ref_id")
  note          String?
  createdByUserId String? @map("created_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([medicineId, warehouseId, createdAt])
  @@index([refType, refId])
  @@index([batchId])
  @@map("inventory_movements")
}

model stockAdjustment {
  id              String   @id @default(cuid())
  adjustmentNo    String   @map("adjustment_no") @unique
  medicineId      String   @map("medicine_id")
  warehouseId     String   @map("warehouse_id")
  type            String   // increase | decrease
  quantity        Decimal  @db.Decimal(18, 3)
  previousQty     Decimal  @db.Decimal(18, 3) @map("previous_qty")
  newQty          Decimal  @db.Decimal(18, 3) @map("new_qty")
  reason          String
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([medicineId])
  @@index([createdAt])
  @@map("stock_adjustments")
}

// ── Suppliers ────────────────────────────────────────────────────────────────

model supplier {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?  @map("name_ar")
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  governorate   String?
  city          String?
  taxNumber     String?  @map("tax_number")
  paymentTerms  String?  @map("payment_terms")
  creditLimit   BigInt   @default(0) @map("credit_limit")
  balance       BigInt   @default(0)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([name])
  @@map("suppliers")
}

model supplierPayment {
  id            String   @id @default(cuid())
  supplierId    String   @map("supplier_id")
  purchaseId    String?  @map("purchase_id")
  amount        BigInt
  method        String   @default("cash")
  note          String?
  createdByUserId String? @map("created_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([supplierId, createdAt])
  @@index([purchaseId])
  @@map("supplier_payments")
}

// ── Customers ────────────────────────────────────────────────────────────────

model customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  address       String?
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?
  creditLimit   BigInt   @default(0) @map("credit_limit")
  balance       BigInt   @default(0)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([phone])
  @@map("customers")
}

// ── Doctors ──────────────────────────────────────────────────────────────────

model doctor {
  id            String   @id @default(cuid())
  name          String
  specialty     String?
  phone         String?
  clinic        String?
  hospital      String?
  licenseNo     String?  @map("license_no")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("doctors")
}

// ── Employees ────────────────────────────────────────────────────────────────

model employee {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  name          String
  nameAr        String?  @map("name_ar")
  phone         String?
  email         String?
  role          String
  branchId      String?  @map("branch_id")
  salary        BigInt?
  hireDate      DateTime? @map("hire_date")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("employees")
}

// ── Purchases ────────────────────────────────────────────────────────────────

model purchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique @map("po_number")
  supplierId      String   @map("supplier_id")
  warehouseId     String?  @map("warehouse_id")
  /// draft | ordered | partially_received | received | cancelled
  status          String   @default("draft")
  orderDate       DateTime @default(now()) @map("order_date")
  expectedDate    DateTime? @map("expected_date")
  receivedDate    DateTime? @map("received_date")
  subtotal        BigInt
  discountTotal   BigInt   @default(0) @map("discount_total")
  total           BigInt
  paidTotal       BigInt   @default(0) @map("paid_total")
  notes           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([supplierId])
  @@index([orderDate])
  @@map("purchase_orders")
}

model purchaseItem {
  id              String  @id @default(cuid())
  purchaseOrderId String  @map("purchase_order_id")
  medicineId      String  @map("medicine_id")
  quantity        Decimal @db.Decimal(18, 3)
  receivedQty     Decimal @default(0) @db.Decimal(18, 3) @map("received_qty")
  unitCost        BigInt  @map("unit_cost")
  discount        BigInt  @default(0)
  lineTotal       BigInt  @map("line_total")

  @@index([purchaseOrderId])
  @@index([medicineId])
  @@map("purchase_items")
}

// ── Sales ────────────────────────────────────────────────────────────────────

model salesInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique @map("invoice_number")
  customerId      String?  @map("customer_id")
  doctorId        String?  @map("doctor_id")
  prescriptionId  String?  @map("prescription_id")
  warehouseId     String?  @map("warehouse_id")
  /// posted | voided
  status          String   @default("posted")
  issuedAt        DateTime @default(now()) @map("issued_at")
  subtotal        BigInt
  discountTotal   BigInt   @default(0) @map("discount_total")
  taxTotal        BigInt   @default(0) @map("tax_total")
  total           BigInt
  paidTotal       BigInt   @default(0) @map("paid_total")
  /// cash | credit | mixed
  paymentMethod   String   @default("cash") @map("payment_method")
  notes           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([issuedAt])
  @@index([customerId])
  @@index([doctorId])
  @@index([status])
  @@index([prescriptionId])
  @@map("sales_invoices")
}

model salesInvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String  @map("invoice_id")
  medicineId    String  @map("medicine_id")
  batchId       String? @map("batch_id")
  qty           Decimal @db.Decimal(18, 3)
  unitPrice     BigInt  @map("unit_price")
  discount      BigInt  @default(0)
  taxRateBps    Int     @default(0) @map("tax_rate_bps")
  lineSubtotal  BigInt  @map("line_subtotal")
  lineTax       BigInt  @default(0) @map("line_tax")
  lineTotal     BigInt  @map("line_total")
  unitCost      BigInt  @default(0) @map("unit_cost")

  @@index([invoiceId])
  @@index([medicineId])
  @@index([batchId])
  @@map("sales_invoice_items")
}

model payment {
  id            String   @id @default(cuid())
  invoiceId     String   @map("invoice_id")
  method        String
  amount        BigInt
  cashAccountId String?  @map("cash_account_id")
  createdByUserId String? @map("created_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([cashAccountId])
  @@map("payments")
}

// ── Returns ──────────────────────────────────────────────────────────────────

model salesReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique @map("return_number")
  invoiceId     String   @map("invoice_id")
  total         BigInt
  refunded      BigInt   @default(0)
  reason        String?
  createdByUserId String? @map("created_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("sales_returns")
}

model salesReturnItem {
  id            String  @id @default(cuid())
  returnId      String  @map("return_id")
  medicineId    String  @map("medicine_id")
  batchId       String? @map("batch_id")
  qty           Decimal @db.Decimal(18, 3)
  unitPrice     BigInt  @map("unit_price")
  lineTotal     BigInt  @map("line_total")

  @@index([returnId])
  @@index([medicineId])
  @@map("sales_return_items")
}

model supplierReturn {
  id              String   @id @default(cuid())
  returnNumber    String   @unique @map("return_number")
  supplierId      String   @map("supplier_id")
  purchaseId      String?  @map("purchase_id")
  total           BigInt
  refundAmount    BigInt   @default(0) @map("refund_amount")
  /// expired | damaged | wrong_shipment | recall | other
  reason          String
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([createdAt])
  @@map("supplier_returns")
}

model supplierReturnItem {
  id              String  @id @default(cuid())
  supplierReturnId String @map("supplier_return_id")
  medicineId      String  @map("medicine_id")
  batchId         String? @map("batch_id")
  quantity        Decimal @db.Decimal(18, 3)
  unitCost        BigInt  @map("unit_cost")
  lineTotal       BigInt  @map("line_total")

  @@index([supplierReturnId])
  @@index([medicineId])
  @@map("supplier_return_items")
}

// ── Prescriptions ────────────────────────────────────────────────────────────

model prescription {
  id            String   @id @default(cuid())
  prescriptionNo String  @unique @map("prescription_no")
  customerId    String?  @map("customer_id")
  doctorId      String?  @map("doctor_id")
  issueDate     DateTime @default(now()) @map("issue_date")
  /// pending | dispensed | partial | cancelled
  status        String   @default("pending")
  notes         String?
  createdByUserId String? @map("created_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([doctorId])
  @@index([status])
  @@map("prescriptions")
}

model prescriptionItem {
  id               String   @id @default(cuid())
  prescriptionId   String   @map("prescription_id")
  medicineId       String?  @map("medicine_id")
  medicineName     String   @map("medicine_name")
  dosage           String?
  frequency        String?
  duration         String?
  quantity         Decimal? @db.Decimal(18, 3)
  dispensedQty     Decimal  @default(0) @db.Decimal(18, 3) @map("dispensed_qty")
  notes            String?

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ── Expenses ─────────────────────────────────────────────────────────────────

model expenseCategory {
  id        String   @id @default(cuid())
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("expense_categories")
}

model expense {
  id              String   @id @default(cuid())
  categoryId      String?  @map("category_id")
  amount          BigInt
  description     String?
  paidAt          DateTime @default(now()) @map("paid_at")
  method          String   @default("cash")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([categoryId])
  @@index([paidAt])
  @@map("expenses")
}

// ── Cash Management ──────────────────────────────────────────────────────────

model cashAccount {
  id              String   @id @default(cuid())
  nameAr          String   @map("name_ar")
  nameEn          String?  @map("name_en")
  type            String   @default("cash")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("cash_accounts")
}

model cashSession {
  id              String   @id @default(cuid())
  cashAccountId   String   @map("cash_account_id")
  userId          String   @map("user_id")
  openingBalance  BigInt   @default(0) @map("opening_balance")
  closingBalance  BigInt?  @map("closing_balance")
  actualBalance   BigInt?  @map("actual_balance")
  discrepancy     BigInt?  @default(0)
  /// open | closed
  status          String   @default("open")
  openedAt        DateTime @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  notes           String?

  @@index([cashAccountId, status])
  @@index([userId])
  @@map("cash_sessions")
}

model cashMovement {
  id              String   @id @default(cuid())
  cashAccountId   String   @map("cash_account_id")
  sessionId       String?  @map("session_id")
  delta           BigInt
  /// sale_payment | purchase_payment | expense | refund | deposit | withdrawal | opening | closing
  reason          String
  refType         String?  @map("ref_type")
  refId           String?  @map("ref_id")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([cashAccountId, createdAt])
  @@index([sessionId])
  @@map("cash_movements")
}

// ── Number Sequences ─────────────────────────────────────────────────────────

model numberSequence {
  id         String @id @default(cuid())
  key        String @unique
  prefix     String?
  nextValue  Int    @default(1) @map("next_value")
  padding    Int    @default(5)
}

// ── POS Hold ─────────────────────────────────────────────────────────────────

model posHold {
  id              String   @id @default(cuid())
  customerId      String?  @map("customer_id")
  warehouseId     String?  @map("warehouse_id")
  cart            Json
  label           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdByUserId])
  @@map("pos_holds")
}

// ── Password reset tokens ────────────────────────────────────────────────────
// (Already defined above as passwordResetToken)
